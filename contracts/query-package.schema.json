{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/power-query-manager/schemas/query-package",
  "title": "Power Query Manager query package manifests v1 and v2",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"}
  ],
  "$defs": {
    "queryName": {"type": "string", "minLength": 1, "maxLength": 255},
    "file": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "entryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_name", "file", "order", "sha256"],
      "properties": {
        "query_name": {"$ref": "#/$defs/queryName"},
        "file": {"$ref": "#/$defs/file"},
        "order": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "entryV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_name", "file", "order", "sha256", "dependencies", "dependency_status"],
      "properties": {
        "query_name": {"$ref": "#/$defs/queryName"},
        "file": {"$ref": "#/$defs/file"},
        "order": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/queryName"}},
        "dependency_status": {"enum": ["known", "ambiguous"]}
      }
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "package_type", "queries"],
      "properties": {
        "schema_version": {"const": 1},
        "package_type": {"const": "power-query-manager-query-package"},
        "queries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entryV1"}}
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "package_type", "queries", "dependency_cycles"],
      "properties": {
        "schema_version": {"const": 2},
        "package_type": {"const": "power-query-manager-query-package"},
        "queries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entryV2"}},
        "dependency_cycles": {"type": "array", "items": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/queryName"}}}
      }
    }
  }
}
