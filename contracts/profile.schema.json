{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/power-query-manager/schemas/profile/v1",
  "title": "Power Query Manager import profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_name",
    "workbook",
    "options",
    "queries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "workbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existing_query_policy",
        "backup",
        "dry_run",
        "refresh"
      ],
      "properties": {
        "existing_query_policy": {
          "enum": [
            "replace",
            "skip",
            "review_each"
          ]
        },
        "backup": {
          "type": "boolean"
        },
        "dry_run": {
          "type": "boolean"
        },
        "refresh": {
          "enum": [
            "none",
            "selected",
            "all"
          ]
        },
        "import_order": {
          "enum": [
            "manual",
            "filename_prefix",
            "dependency_suggestion"
          ]
        },
        "staged_output": {
          "type": "boolean"
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/query"
      }
    },
    "path_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "from",
          "to",
          "enabled"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "environment_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "from", "to", "enabled"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "definition_only",
            "connection_only",
            "new_sheet",
            "existing_sheet",
            "data_model",
            "preserve_existing"
          ]
        },
        "sheet_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31
        },
        "cell": {
          "type": "string",
          "pattern": "^\\$?[A-Za-z]{1,3}\\$?[1-9][0-9]{0,6}$"
        },
        "table_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "existing_sheet"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "sheet_name",
              "cell"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "new_sheet"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "cell"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "definition_only",
                  "connection_only",
                  "data_model",
                  "preserve_existing"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sheet_name"
                  ]
                },
                {
                  "required": [
                    "cell"
                  ]
                },
                {
                  "required": [
                    "table_name"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_path",
        "query_name",
        "enabled",
        "order",
        "load"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "query_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "enabled": {
          "type": "boolean"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "existing_policy": {
          "enum": [
            "replace",
            "skip",
            "review"
          ]
        },
        "load": {
          "$ref": "#/$defs/load"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
